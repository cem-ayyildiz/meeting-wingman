#!/usr/bin/env bash
# SC2029: remote commands are built locally on purpose ($RDIR is ours). SC2012: chunk names are HHMMSS.wav.
# shellcheck disable=SC2029,SC2012
# meeting-wingman: live transcript of a Meet, Teams or Zoom call, streamed into Claude Code.
#
#   wingman start [options]    start listening (returns when it is ready)
#   wingman watch [N] [--raw]  print events for Claude: triggers at once, quiet lines as a digest
#                              every few minutes (--raw: every line). N = old lines to replay first
#   wingman show [N]           print the last N transcript lines (default 30)
#   wingman stop [OUT.txt]     stop, save the transcript to OUT.txt, keep no other copy
#   wingman doctor             check the setup and say what is missing
#   wingman level [SECONDS]    measure the system audio and microphone levels
#   wingman status
#
# start options:
#   -l LANG        meeting language: tr, en, de ... or auto (default)
#   -x LANG        also translate every line into LANG, on GPU or CPU
#   -t "a, b"      recognition hints: names, products, acronyms   (-T FILE: the same from a file)
#   -m MODE        coach | team | both: what wakes Claude (default both)
#   -n "names"     the user's name(s), so "Ana, what do you think?" wakes Claude
#   --captions     read the meeting's own captions from the browser instead of recording audio
#                  (Meet, Teams or Zoom web client; gives speaker names, needs no GPU)
#   --cdp main|PORT  browser for --captions (default main = your own Chrome/Edge, asks once)
#   --no-mic       record only the system audio (when you speak from another device)
#   --local | --remote HOST   where to transcribe (default: WINGMAN_REMOTE_HOST if set, else here)
#
# Configuration (environment, or ~/.config/meeting-wingman/config as KEY=value lines):
#   WINGMAN_REMOTE_HOST    SSH host with a GPU; when set, transcription runs there
#   WINGMAN_REMOTE_PYTHON  python with faster-whisper on that host  (default: python3)
#   WINGMAN_REMOTE_DIR     working directory on that host            (default: .meeting-wingman)
#   WINGMAN_PYTHON         local python with faster-whisper          (default: python3)
#   WINGMAN_MODEL          faster-whisper model (default: large-v3 on GPU, small on CPU)
#   WINGMAN_DEVICE         cuda | cpu | auto; auto = GPU if usable, else CPU (default: auto)
#   WINGMAN_TRANSLATE_MODEL  CTranslate2 NLLB model for -x (default: 1.3B on GPU, 600M on CPU)
#   WINGMAN_AUDIO_SOURCE   what to record. Linux: a PulseAudio/PipeWire source
#                          (default @DEFAULT_MONITOR@ = what the speakers play).
#                          macOS: an avfoundation audio device (default "BlackHole 2ch")
#   WINGMAN_MIC            auto (default: the default microphone) | none | a source name
#   WINGMAN_PAUSE          pause in seconds that ends an utterance   (default: 0.7)
#   WINGMAN_DIGEST         seconds between digests of quiet lines    (default: 300)
#   WINGMAN_NAMES          default for -n
#   WINGMAN_CDP            default for --cdp
#
# Everything runs detached (setsid), so it survives the agent's background-task limits.
set -u
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SELF")"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/meeting-wingman/config"
# shellcheck disable=SC1090
[ -f "$CONF" ] && set -a && . "$CONF" && set +a
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/meeting-wingman"
SEG="$STATE/chunks"
LOCAL="$STATE/local"
RHOST="${WINGMAN_REMOTE_HOST:-}"
RPY="${WINGMAN_REMOTE_PYTHON:-python3}"
RDIR="${WINGMAN_REMOTE_DIR:-.meeting-wingman}"
LPY="${WINGMAN_PYTHON:-python3}"
OS="$(uname -s)"
mkdir -p "$STATE"

die() { echo "ERROR: $*" >&2; exit 1; }
# Prefix for detached jobs. Used directly (not via a function) so that $! is the real PID.
DETACH=(nohup); command -v setsid >/dev/null && DETACH=(setsid nohup)
mode() { cat "$STATE/mode" 2>/dev/null; }
alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
getstate() { cat "$STATE/$1" 2>/dev/null; }

default_mic() {   # the default microphone, or nothing when there is none (or it is a monitor)
  case "${WINGMAN_MIC:-auto}" in
    none) return ;;
    auto) ;;
    *) echo "$WINGMAN_MIC"; return ;;
  esac
  [ "$OS" = Darwin ] && return   # macOS: set WINGMAN_MIC to the device name to mix it in
  local src=""
  if command -v pactl >/dev/null; then
    src="$(pactl get-default-source 2>/dev/null)"
  elif command -v wpctl >/dev/null; then
    src="$(wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | sed -n 's/.*node\.name = "\(.*\)"/\1/p' | head -1)"
  fi
  [ -n "$src" ] && [[ "$src" != *.monitor ]] && echo "$src"
  true
}

audio_input() {   # $1 = microphone source or empty. Prints ffmpeg input arguments, one per line.
  local mic="${1:-}"
  if [ "$OS" = Darwin ]; then
    printf '%s\n' -f avfoundation -i ":${WINGMAN_AUDIO_SOURCE:-BlackHole 2ch}"
    [ -n "$mic" ] && printf '%s\n' -f avfoundation -i ":$mic"
  else
    printf '%s\n' -f pulse -i "${WINGMAN_AUDIO_SOURCE:-@DEFAULT_MONITOR@}"
    [ -n "$mic" ] && printf '%s\n' -f pulse -i "$mic"
  fi
  [ -n "$mic" ] && printf '%s\n' -filter_complex "amix=inputs=2:normalize=0:duration=longest"
  true
}

wait_ready() {   # $1 = command printing the log, $2 = regex for ready. Fails fast on a crash.
  local log
  for _ in $(seq 1 100); do
    log="$(eval "$1" 2>/dev/null)"
    grep -qE "$2" <<<"$log" && return 0
    grep -qE "^Traceback|no device worked|^ERROR" <<<"$log" && return 1
    sleep 2
  done
  return 1
}

ship() {   # remote mode: send finished utterances (complete files only; .part is still being written)
  local f
  mapfile -t f < <(ls "$SEG"/*.wav 2>/dev/null | sort)
  if (( ${#f[@]} )); then rsync -q --remove-source-files "${f[@]}" "$RHOST:$RDIR/in/" || true; fi
}

cmd_capture() {   # internal: started by `start`
  mkdir -p "$SEG"
  rm -f "$SEG"/*.wav "$SEG"/*.part
  mapfile -t IN < <(audio_input "$(getstate mic)")
  ffmpeg -nostdin -loglevel error "${IN[@]}" -ac 1 -ar 16000 -f s16le - | "$LPY" "$DIR/segmenter.py" "$SEG" &
  SG=$!
  trap 'kill $(jobs -p) 2>/dev/null' EXIT INT TERM
  if [ "$(mode)" = local ]; then wait $SG; exit; fi
  while kill -0 $SG 2>/dev/null; do ship; sleep 1; done
}

start_captions() {   # $1 lang, $2 xlang, $3 cdp
  mkdir -p "$LOCAL"
  [ -s "$LOCAL/transcript.txt" ] && mv "$LOCAL/transcript.txt" "$LOCAL/transcript-$(date +%Y%m%d-%H%M%S).txt"
  : > "$LOCAL/transcript.txt"
  WINGMAN_LANG="$1" "${DETACH[@]}" "$LPY" "$DIR/captions.py" "$LOCAL/transcript.txt" --cdp "$3" \
    ${2:+--translate "$2"} > "$LOCAL/server.log" 2>&1 < /dev/null &
  echo $! > "$STATE/server.pid"
  echo "Connecting to the browser ($3). If it asks \"Allow remote debugging?\", approve it."
  if ! wait_ready "cat '$LOCAL/server.log'" "captions ready|waiting for a"; then
    tail -5 "$LOCAL/server.log" >&2
    alive "$STATE/server.pid" && kill "$(cat "$STATE/server.pid")"
    die "could not read captions. Is remote debugging on (chrome://inspect/#remote-debugging), or the browser started with --remote-debugging-port?"
  fi
  grep -E "captions ready|waiting for a" "$LOCAL/server.log" | tail -1
  echo captions > "$STATE/mode"
}

start_remote() {   # $1 lang, $2 xlang, $3 terms. Returns 1 to fall back to local.
  command -v rsync >/dev/null || die "rsync not found"
  ssh "$RHOST" "mkdir -p $RDIR/in"
  scp -q "$DIR/transcribe_server.py" "$DIR/translate.py" "$RHOST:$RDIR/"
  printf '%s' "$3" | ssh "$RHOST" "cat > $RDIR/terms.txt"
  # Stop an old server by its PID file. Never `pkill -f` over ssh: the remote shell's own
  # command line matches the pattern and the shell kills itself.
  ssh "$RHOST" "cd $RDIR && [ -f server.pid ] && kill \$(cat server.pid) 2>/dev/null; rm -f server.pid in/*.wav; [ -s transcript.txt ] && mv transcript.txt transcript-\$(date +%Y%m%d-%H%M%S).txt; : > transcript.txt"
  sleep 1
  # "cd X && cmd &" would background the whole list in a subshell and $! would be that subshell.
  timeout 20 ssh -n -f "$RHOST" "cd $RDIR || exit 1; WINGMAN_DIR=. WINGMAN_LANG='$1' WINGMAN_TRANSLATE='$2' WINGMAN_TRANSLATE_MODEL='${WINGMAN_TRANSLATE_MODEL:-}' WINGMAN_MODEL='${WINGMAN_MODEL:-}' WINGMAN_DEVICE='${WINGMAN_DEVICE:-auto}' setsid nohup $RPY transcribe_server.py > server.log 2>&1 < /dev/null & echo \$! > server.pid"
  echo "Loading the model on $RHOST (the first run downloads it)..."
  if wait_ready "ssh $RHOST 'cat $RDIR/server.log'" "model ready"; then
    ssh "$RHOST" "grep 'model ready' $RDIR/server.log"
    echo remote > "$STATE/mode"
    echo "$RHOST" > "$STATE/host"
    return 0
  fi
  ssh "$RHOST" "tail -3 $RDIR/server.log; cd $RDIR && [ -f server.pid ] && kill \$(cat server.pid) 2>/dev/null; rm -f server.pid" >&2
  echo "WARNING: the server on $RHOST did not start. Falling back to local transcription."
  return 1
}

start_local() {   # $1 lang, $2 xlang, $3 terms
  # WINGMAN_MODEL is meant for the remote GPU when one is configured; locally pick by device.
  local lmodel="${WINGMAN_MODEL:-}"; [ -n "$RHOST" ] && lmodel=""
  "$LPY" -c "import faster_whisper" 2>/dev/null || die "faster-whisper is not installed for $LPY (pip install faster-whisper). Or use --captions."
  mkdir -p "$LOCAL" "$SEG"
  printf '%s' "$3" > "$LOCAL/terms.txt"
  [ -s "$LOCAL/transcript.txt" ] && mv "$LOCAL/transcript.txt" "$LOCAL/transcript-$(date +%Y%m%d-%H%M%S).txt"
  : > "$LOCAL/transcript.txt"
  WINGMAN_DIR="$LOCAL" WINGMAN_IN="$SEG" WINGMAN_LANG="$1" WINGMAN_TRANSLATE="$2" WINGMAN_MODEL="$lmodel" \
    "${DETACH[@]}" "$LPY" "$DIR/transcribe_server.py" > "$LOCAL/server.log" 2>&1 < /dev/null &
  echo $! > "$STATE/server.pid"
  echo "Loading the model locally (the first run downloads it)..."
  wait_ready "cat '$LOCAL/server.log'" "model ready" || { tail -20 "$LOCAL/server.log" >&2; die "local server did not become ready"; }
  grep 'model ready' "$LOCAL/server.log"
  echo local > "$STATE/mode"
}

cmd_start() {
  local lang="" xlang="" terms="" force_local=0 gmode=both names="${WINGMAN_NAMES:-}" captions=0 cdpt="${WINGMAN_CDP:-main}" nomic=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -l) lang="$2"; shift 2 ;;
      -x) xlang="$2"; shift 2 ;;
      -t) terms="$2"; shift 2 ;;
      -T) terms="$(cat "$2")"; shift 2 ;;
      -m) gmode="$2"; shift 2 ;;
      -n) names="$2"; shift 2 ;;
      --captions) captions=1; shift ;;
      --cdp) cdpt="$2"; shift 2 ;;
      --no-mic) nomic=1; shift ;;
      --local) force_local=1; shift ;;
      --remote) RHOST="$2"; shift 2 ;;
      *) die "unknown option: $1 (see: wingman help)" ;;
    esac
  done
  [ "$lang" = auto ] && lang=""
  case "$gmode" in coach|team|both) ;; *) die "-m must be coach, team or both" ;; esac
  { alive "$STATE/capture.pid" || alive "$STATE/server.pid"; } && die "already running. Run: wingman stop"
  printf '%s\n%s\n' "$gmode" "$names" > "$STATE/gate"

  if [ $captions = 1 ]; then
    start_captions "$lang" "$xlang" "$cdpt"
    echo "READY: captions from the browser${xlang:+, translating to $xlang}. Lines arrive about 2 s after each caption settles."
    echo "Watch: wingman watch    Stop: wingman stop <out.txt>"
    return
  fi

  command -v ffmpeg >/dev/null || die "ffmpeg not found"
  local use_remote=0
  if [ $force_local = 0 ] && [ -n "$RHOST" ]; then
    if timeout 8 ssh -o BatchMode=yes "$RHOST" true 2>/dev/null; then
      use_remote=1
    else
      echo "WARNING: cannot SSH to $RHOST without a prompt (key not loaded in the agent? try ssh-add)."
      echo "         Falling back to local transcription. Once fixed: wingman stop && wingman start ..."
    fi
  fi
  if [ $use_remote = 1 ]; then start_remote "$lang" "$xlang" "$terms" || use_remote=0; fi
  [ $use_remote = 0 ] && start_local "$lang" "$xlang" "$terms"

  local mic=""; [ $nomic = 0 ] && mic="$(default_mic)"
  printf '%s' "$mic" > "$STATE/mic"
  WINGMAN_REMOTE_HOST="$RHOST" "${DETACH[@]}" "$SELF" _capture > "$STATE/capture.log" 2>&1 < /dev/null &
  echo $! > "$STATE/capture.pid"
  sleep 2
  alive "$STATE/capture.pid" || { cat "$STATE/capture.log" >&2; die "audio capture did not start"; }
  echo "READY: mode $(mode), language ${lang:-auto}${xlang:+, translating to $xlang}, microphone ${mic:-off}."
  echo "Lines arrive a few seconds after each pause. Watch: wingman watch    Stop: wingman stop <out.txt>"
}

transcript_stream() {   # $1 = old lines to replay
  local n="$1" host
  case "$(mode)" in
    local|captions) exec tail -n "$n" -F "$LOCAL/transcript.txt" ;;
    remote)
      host="$(getstate host)"
      while true; do   # reconnect on drop
        ssh -o BatchMode=yes -o ServerAliveInterval=15 "$host" "touch $RDIR/transcript.txt; tail -n $n -F $RDIR/transcript.txt" 2>/dev/null
        n=0
        sleep 5
      done ;;
    *) die "not running. Run: wingman start" ;;
  esac
}

cmd_watch() {
  local n=0 raw=0 gmode names
  for a in "$@"; do
    case "$a" in --raw) raw=1 ;; *[!0-9]*) die "usage: wingman watch [N] [--raw]" ;; *) n="$a" ;; esac
  done
  [ -n "$(mode)" ] || die "not running. Run: wingman start"
  gmode="$(sed -n 1p "$STATE/gate" 2>/dev/null)"; names="$(sed -n 2p "$STATE/gate" 2>/dev/null)"
  if [ $raw = 1 ]; then
    transcript_stream "$n"
  else
    local sp=(); [ "$(mode)" = captions ] && sp=(--speakers)
    transcript_stream "$n" | "$LPY" -u "$DIR/gate.py" --mode "${gmode:-both}" --names "$names" --digest "${WINGMAN_DIGEST:-300}" "${sp[@]}"
  fi
}

cmd_show() {
  local n="${1:-30}"
  case "$(mode)" in
    local|captions) tail -n "$n" "$LOCAL/transcript.txt" ;;
    remote) ssh "$(getstate host)" "tail -n $n $RDIR/transcript.txt" ;;
    *) die "not running" ;;
  esac
}

cmd_stop() {
  local out="${1:-$STATE/transcript-$(date +%Y%m%d-%H%M%S).txt}" m host p
  m="$(mode)"; host="$(getstate host)"
  [ -n "$m" ] || die "not running"
  if [ -f "$STATE/capture.pid" ]; then
    p=$(cat "$STATE/capture.pid")
    kill -TERM -- "-$p" 2>/dev/null || kill "$p" 2>/dev/null   # process group: ffmpeg + segmenter + shipping
    rm -f "$STATE/capture.pid"
    sleep 1   # the segmenter writes the utterance in progress on SIGTERM
  fi
  mkdir -p "$(dirname "$out")"
  case "$m" in
    local)
      for _ in $(seq 1 20); do ls "$SEG"/*.wav >/dev/null 2>&1 || break; sleep 1; done   # let the last ones finish
      alive "$STATE/server.pid" && kill "$(cat "$STATE/server.pid")"
      rm -f "$STATE/server.pid" "$SEG"/*.wav "$SEG"/*.part "$LOCAL/terms.txt"
      mv "$LOCAL/transcript.txt" "$out" ;;   # hand it over and keep no copy behind
    captions)
      alive "$STATE/server.pid" && kill "$(cat "$STATE/server.pid")"
      rm -f "$STATE/server.pid"
      mv "$LOCAL/transcript.txt" "$out" ;;
    remote)
      RHOST="$host" ship
      for _ in $(seq 1 20); do [ -z "$(ssh "$host" "ls $RDIR/in" 2>/dev/null)" ] && break; sleep 1; done
      ssh "$host" "cd $RDIR && [ -f server.pid ] && kill \$(cat server.pid) 2>/dev/null; rm -f server.pid; true"
      # Fetch, and delete the copy on the host only when the fetch worked.
      if ssh "$host" "cat $RDIR/transcript.txt" > "$out"; then
        ssh "$host" "cd $RDIR && rm -f transcript.txt terms.txt in/*.wav"
      else
        echo "WARNING: could not fetch the transcript; it is still on $host in $RDIR/transcript.txt" >&2
      fi
      rm -f "$SEG"/*.wav "$SEG"/*.part ;;
  esac
  rm -f "$STATE/mode" "$STATE/host" "$STATE/mic" "$STATE/gate"
  local n; n=$(wc -l < "$out")
  echo "Transcript: $out ($n lines${n:+, $(head -c 10 "$out") to $(tail -1 "$out" | head -c 10)})"
}

level_of() {   # ffmpeg input args... -> "mean / max dB"
  local tmp; tmp="$(mktemp -d)/level.wav"
  if ffmpeg -nostdin -loglevel error -y "$@" -t "${LEVEL_SECONDS:-3}" -ac 1 -ar 16000 "$tmp" 2>/dev/null; then
    ffmpeg -nostdin -hide_banner -i "$tmp" -af volumedetect -f null - 2>&1 |
      sed -n 's/.*mean_volume: \(.*\) dB/mean \1 dB/p; s/.*max_volume: \(.*\) dB/max \1 dB/p' | paste -sd' ' -
  else
    echo "capture failed"
  fi
  rm -rf "$(dirname "$tmp")"
}

cmd_level() {
  local mic; mic="$(default_mic)"
  export LEVEL_SECONDS="${1:-3}"
  if [ "$OS" = Darwin ]; then
    echo "system audio: $(level_of -f avfoundation -i ":${WINGMAN_AUDIO_SOURCE:-BlackHole 2ch}")"
    [ -n "$mic" ] && echo "microphone:   $(level_of -f avfoundation -i ":$mic")"
  else
    echo "system audio: $(level_of -f pulse -i "${WINGMAN_AUDIO_SOURCE:-@DEFAULT_MONITOR@}")"
    if [ -n "$mic" ]; then echo "microphone:   $(level_of -f pulse -i "$mic")  ($mic)"; else echo "microphone:   none found"; fi
  fi
  echo "Around -60 dB or lower = silence: nothing is playing, the app is muted, or the wrong device is selected."
}

cmd_doctor() {
  local ok="  ✓" no="  ✗" warn="  !" v
  echo "meeting-wingman doctor"
  echo "Audio pipeline (needed unless you use --captions):"
  if command -v ffmpeg >/dev/null; then
    echo "$ok ffmpeg $(ffmpeg -version | head -1 | cut -d' ' -f3)"
    if [ "$OS" != Darwin ] && ! ffmpeg -hide_banner -devices 2>/dev/null | grep -q pulse; then
      echo "$no this ffmpeg has no PulseAudio input (install a distribution ffmpeg)"; fi
  else
    echo "$no ffmpeg not found: install it (apt install ffmpeg / brew install ffmpeg)"
  fi
  if v="$("$LPY" -c 'import sys; print(sys.version.split()[0])' 2>/dev/null)"; then echo "$ok python $v ($LPY)"; else echo "$no python not found: $LPY"; fi
  if v="$("$LPY" -c 'import faster_whisper; print(faster_whisper.__version__)' 2>/dev/null)"; then
    echo "$ok faster-whisper $v"
  else
    echo "$no faster-whisper missing: $LPY -m pip install faster-whisper"
  fi
  v="$("$LPY" -c 'import ctranslate2; print(ctranslate2.get_cuda_device_count())' 2>/dev/null)"
  if [ "${v:-0}" -gt 0 ] 2>/dev/null; then
    echo "$ok GPU usable ($v CUDA device$( [ "$v" = 1 ] || echo s)): large-v3 model"
    command -v nvidia-smi >/dev/null && echo "     free GPU memory: $(nvidia-smi --query-gpu=memory.free --format=csv,noheader | head -1) (large-v3 needs about 4 GB)"
  else
    echo "$warn no usable GPU here: the CPU runs the small model (fine, less accurate). A GPU box: WINGMAN_REMOTE_HOST"
  fi
  if [ "$OS" = Darwin ]; then
    echo "$warn macOS: system audio needs a loopback device such as BlackHole (beta)"
  else
    echo "  system audio: $(LEVEL_SECONDS=2 level_of -f pulse -i "${WINGMAN_AUDIO_SOURCE:-@DEFAULT_MONITOR@}")"
  fi
  v="$(default_mic)"
  if [ -n "$v" ]; then echo "$ok microphone: $v (mixed in; --no-mic to leave it out)"; else echo "$warn no microphone found: only what the computer plays is recorded"; fi
  if [ -n "$RHOST" ]; then
    echo "Remote GPU host ($RHOST):"
    if timeout 8 ssh -o BatchMode=yes "$RHOST" true 2>/dev/null; then
      echo "$ok ssh works without a prompt"
      v="$(ssh "$RHOST" "$RPY -c 'import faster_whisper,ctranslate2; print(faster_whisper.__version__, ctranslate2.get_cuda_device_count())'" 2>/dev/null)"
      if [ -n "$v" ]; then echo "$ok faster-whisper ${v% *}, CUDA devices: ${v#* }"; else echo "$no faster-whisper not importable with $RPY on $RHOST"; fi
      v="$(ssh "$RHOST" 'nvidia-smi --query-gpu=memory.free --format=csv,noheader 2>/dev/null | head -1')"
      [ -n "$v" ] && echo "     free GPU memory there: $v"
      command -v rsync >/dev/null && echo "$ok rsync" || echo "$no rsync missing here"
    else
      echo "$no cannot ssh without a prompt: load your key (ssh-add) or check the host name"
    fi
  fi
  echo "Captions (--captions, Meet/Teams/Zoom in the browser):"
  v="$(ls -t ~/.config/google-chrome/DevToolsActivePort ~/.config/chromium/DevToolsActivePort \
        ~/.config/microsoft-edge/DevToolsActivePort ~/.config/BraveSoftware/Brave-Browser/DevToolsActivePort \
        "$HOME/Library/Application Support/Google/Chrome/DevToolsActivePort" 2>/dev/null | head -1)"
  if [ -n "$v" ]; then
    echo "$ok remote debugging is on ($v). The browser asks once per session to allow it"
  elif [ -n "${WINGMAN_CDP:-}" ] && [ "${WINGMAN_CDP}" != main ]; then
    curl -s -m 2 "http://127.0.0.1:$WINGMAN_CDP/json/version" >/dev/null && echo "$ok debugging port $WINGMAN_CDP answers" || echo "$no nothing answers on port $WINGMAN_CDP"
  else
    echo "$warn remote debugging is off: open chrome://inspect/#remote-debugging and turn it on (only for --captions)"
  fi
  echo "Disk: $(df -h "${HF_HOME:-$HOME/.cache}" 2>/dev/null | awk 'NR==2{print $4}') free for models (small 0.5 GB, large-v3 3 GB, translation 0.6–1.4 GB)"
}

cmd_status() {
  echo "mode:    $(mode || true)"
  if [ "$(mode)" != captions ]; then echo "capture: $(alive "$STATE/capture.pid" && echo running || echo stopped)  microphone: $(getstate mic || true)"; fi
  case "$(mode)" in
    local|captions) echo "reader:  $(alive "$STATE/server.pid" && echo running || echo stopped)"; tail -1 "$LOCAL/server.log" 2>/dev/null ;;
    remote) echo "host:    $(getstate host)" ;;
  esac
  [ -f "$STATE/gate" ] && echo "wakes Claude for: $(sed -n 1p "$STATE/gate") mode, names: $(sed -n 2p "$STATE/gate")"
  true
}

case "${1:-help}" in
  start) shift; cmd_start "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  show) shift; cmd_show "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  doctor) cmd_doctor ;;
  level) shift; cmd_level "$@" ;;
  status) cmd_status ;;
  _capture) cmd_capture ;;
  *) sed -n '/^# meeting-wingman:/,/^# Everything runs detached/p' "$SELF" | sed 's/^# \{0,1\}//' ;;
esac
